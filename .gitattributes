# The ISO is built on Linux. CRLF shell scripts fail there with
# "\r: command not found", so the repository always stores LF.
* text=auto

*.sh        text eol=lf
makefile    text eol=lf
*.py        text eol=lf
*.desktop   text eol=lf
*.service   text eol=lf
*.conf      text eol=lf
*.ini       text eol=lf

# core.autocrlf is true system-wide on the Windows build host. These are
# binary and must never be line-ending converted.
*.png       binary
*.zip       binary
*.mo        binary
src/mods/20-deskmon-mod/deskmon binary
